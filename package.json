{
  "name": "flood-zone-lookup-fema-flood-map-mcp",
  "version": "1.0.0",
  "description": "Flood zone lookup MCP server: FEMA flood zone for any US address from the National Flood Hazard Layer (FEMA flood map), with base flood elevation, FIRM panel and effective date, map changes (LOMR), nearby high-risk zones and what the zone means for flood insurance. Hosted, no key.",
  "type": "module",
  "license": "MIT",
  "author": "theluckystrike",
  "mcpName": "io.github.theluckystrike/flood-zone-lookup-fema-flood-map-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/flood-zone-lookup-fema-flood-map-mcp"
  },
  "homepage": "https://www.mcpstamp.com/servers/",
  "bin": {
    "flood-zone-lookup-fema-flood-map-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "start": "node dist/stdio.js",
    "deploy": "npx wrangler@4 deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
